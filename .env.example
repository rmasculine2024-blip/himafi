# Salin file ini jadi `.env`, lalu isi nilainya. `.env` sudah di-gitignore.

# Access key Web3Forms untuk form kontak di /contact.
# Tanpa ini, form tetap tampil tapi pesan yang dikirim TIDAK sampai ke mana pun
# (Web3Forms menolak submit tanpa access key).
# Ambil kuncinya gratis di https://web3forms.com — daftar pakai email pengurus
# yang memang memantau pesan masuk.
#
# Untuk produksi, nilai yang sama harus diisi juga di Netlify:
# Site settings -> Environment variables.
PUBLIC_WEB3FORMS_KEY=
