---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";
import H1 from "../../components/H1.astro";
import Paragraph from "../../components/Paragraph.astro";
import FilterChips from "../../components/FilterChips.astro";
import { LEVEL_ROBOT } from "../../content.config.ts";

const title = "Proyek";
const semuaProyek = await getCollection("proyek");
const sorted = [...semuaProyek].sort((a, b) => b.data.tahun - a.data.tahun);
---

<Layout Pagetitle={title}>
  <Section mode="dark">
    <Container class="py-28 md:py-32">
      <div class="mx-auto max-w-2xl">
        <H1 text={title} mode="center" />
        <Paragraph text="Project showcase klub Robotik & Embedded HIMAFI, per level kurikulum." mode="center" />
      </div>

      <div class="mt-10 flex justify-center">
        <FilterChips groupId="proyek" options={LEVEL_ROBOT} />
      </div>

      <ul
        data-filter-group="proyek"
        class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 border-t border-secondary-bright/30 pt-12"
      >
        {
          sorted.map((p) => (
            <li data-filter-item={p.data.levelBadge}>
              <a
                href={`/proyek/${p.id}`}
                class="block h-full rounded-lg bg-secondary-bright p-5 shadow-sm transition hover:shadow-lg"
              >
                <span class="text-xs font-bold uppercase tracking-widest text-teritary">
                  {p.data.levelBadge} · {p.data.tahun}
                </span>
                <h3 class="mt-2 font-heading font-bold text-primary-darken">{p.data.nama}</h3>
                <p class="mt-2 line-clamp-3 text-sm text-primary">{p.data.deskripsi}</p>
                <span class="mt-3 inline-block text-xs font-semibold text-primary-darken/60 capitalize">
                  {p.data.status}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      {sorted.length < 1 && <Paragraph text="Belum ada proyek yang terdaftar." mode="center" />}
    </Container>
  </Section>
</Layout>
