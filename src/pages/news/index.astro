---
import Layout from "../../layouts/Layout.astro";
import Paragraph from "../../components/Paragraph.astro";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";
import H1 from "../../components/H1.astro";
import { sortNewsByDate } from "../../utils/date.ts";
import { getCollection } from "astro:content";
const title = `Berita`;
import NewsSection from "../../components/newsSection.astro";

const news = await getCollection("news");
const sorted = sortNewsByDate(news);
---

<Layout Pagetitle={title}>
  <Section mode="dark">
    <Container class="py-28 md:py-32">
      <div class="mx-auto max-w-2xl">
        <H1 text={title} mode="center" />
        <Paragraph text="Lihat Berita terupdate di Web HIMAFI" mode="center" />
      </div>
      <div
        class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 border-t border-secondary-bright/30 pt-12"
      >
        {sorted.map((report) => <NewsSection report={report} />)}
      </div>
      {sorted.length < 1 && <Paragraph text="Belum ada berita." mode="center" />}
    </Container>
  </Section>
</Layout>
