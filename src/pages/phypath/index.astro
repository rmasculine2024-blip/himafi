---
// LMS Phypath — statis, tanpa akun/login ("Opsi A"). Progress self-check
// disimpan per perangkat lewat src/lib/progress.ts.
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";
import H1 from "../../components/H1.astro";
import Paragraph from "../../components/Paragraph.astro";

const title = "Phypath";
const semuaCourse = await getCollection("phypath");
---

<Layout Pagetitle={title}>
  <Section mode="dark">
    <Container class="py-28 md:py-32">
      <div class="mx-auto max-w-2xl">
        <H1 text={title} mode="center" />
        <Paragraph text="Jalur belajar fisika mandiri — video, bacaan, dan kuis self-check dari LITBANG HIMAFI." mode="center" />
      </div>

      <ul class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-6 border-t border-secondary-bright/30 pt-12">
        {
          semuaCourse.map((course) => {
            const jumlahModul = course.data.modul.length;
            const jumlahLesson = course.data.modul.reduce((n, m) => n + m.lesson.length, 0);
            return (
              <li>
                <a
                  href={`/phypath/${course.id}`}
                  class="block h-full rounded-lg bg-secondary-bright p-5 shadow-sm transition hover:shadow-lg"
                >
                  {course.data.peminatanTag && (
                    <span class="text-xs font-bold uppercase tracking-widest text-teritary">
                      {course.data.peminatanTag}
                    </span>
                  )}
                  <h3 class="mt-2 font-heading font-bold text-primary-darken">{course.data.judul}</h3>
                  <p class="mt-2 text-sm text-primary">{course.data.deskripsi}</p>
                  <p class="mt-3 text-xs font-semibold text-primary-darken/60">
                    {jumlahModul} modul · {jumlahLesson} lesson
                  </p>
                </a>
              </li>
            );
          })
        }
      </ul>

      {semuaCourse.length < 1 && <Paragraph text="Belum ada course Phypath." mode="center" />}
    </Container>
  </Section>
</Layout>
