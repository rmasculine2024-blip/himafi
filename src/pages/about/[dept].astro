---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import {
  memberImages,
  structureImages,
  findImage,
  programsImages,
} from "../../utils/image";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";
import { sortDepartments } from "../../utils/departments";
export async function getStaticPaths() {
  const departments = await getCollection("departments");
  return departments.map((dept) => ({
    params: { dept: dept.id },
    props: { dept },
  }));
}
import MemberModal from "../../components/MemberModal.astro";
const { dept } = Astro.props;
const programId = `${dept.data.name}Program`;

// Resolve foto header departemen
const deptPhoto = findImage(structureImages, dept.data.photo);
const deptSecPhoto = findImage(structureImages, dept.data.secondPhoto);

// Resolve semua foto member

const resolvedMembers = dept.data.members.map((member) => ({
  ...member,
  resolvedPhoto: findImage(memberImages, member.profilePic),
}));
const resolvedPrograms = dept.data.programs.map((program) => ({
  ...program,
  resolvePicture: findImage(programsImages, program.programPic),
}));

// Navigasi antar-departemen: sebelumnya halaman ini buntu, satu-satunya
// jalan keluar cuma tombol back browser.
const others = sortDepartments(await getCollection("departments")).filter(
  (d) => d.id !== dept.id,
);
---

<Layout
  Pagetitle={dept.data.name}
  description={dept.data.description}
  image={(deptSecPhoto ?? deptPhoto)?.src}
>
  <!-- Hero foto departemen -->
  {
    deptPhoto && (
      <div class="relative md:hidden h-80 w-full overflow-hidden">
        <Image
          src={deptPhoto}
          alt={dept.data.name}
          class="w-full h-full object-cover brightness-75"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 flex flex-col items-center justify-center">
          <h1 class="font-heading font-bold text-5xl text-neutralwhite">
            {dept.data.name}
          </h1>
          <p class="font-isi text-neutralwhite/80 mt-2">{dept.data.fullName}</p>
        </div>
      </div>
    )
  }
  {
    deptSecPhoto && (
      <div class="relative hidden md:block h-120 w-full overflow-hidden">
        <Image
          src={deptSecPhoto}
          alt={dept.data.name}
          class="w-full h-full object-cover brightness-75"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 flex flex-col items-center justify-center">
          <h1 class="font-heading font-bold text-5xl text-neutralwhite">
            {dept.data.name}
          </h1>
          <p class="font-isi text-neutralwhite/80 mt-2">{dept.data.fullName}</p>
        </div>
      </div>
    )
  }

  <Section>
    <div class="flex flex-col w-full min-h-screen">
      <Container class="py-20 md:py-24">
        <nav aria-label="Breadcrumb" class="mb-10">
          <ol
            class="flex flex-wrap items-center gap-x-2 gap-y-1 font-isi text-sm text-primary/60"
          >
            <li><a href="/" class="hover:text-primary">Beranda</a></li>
            <li aria-hidden="true">/</li>
            <li>
              <a href="/about#structure" class="hover:text-primary">Tentang</a>
            </li>
            <li aria-hidden="true">/</li>
            <li>
              <span class="text-primary font-semibold" aria-current="page">
                {dept.data.name}
              </span>
            </li>
          </ol>
        </nav>

        <p class="font-isi max-w-2xl text-fluid-body leading-relaxed">
          {dept.data.description}
        </p>

        <!-- Grid member — tampilannya sengaja sama persis dengan
             MemberDirectory di /about supaya tidak terasa dua halaman beda -->
        <h2
          class="font-heading font-bold text-2xl md:text-3xl mt-14 mb-8 heading-accent heading-accent-left"
        >
          Anggota
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 md:gap-6">
          {
            resolvedMembers.map((member) => (
              <button
                type="button"
                class="lift text-left group cursor-pointer rounded-2xl overflow-hidden bg-neutralwhite ring-1 ring-primary/10 shadow-sm hover:shadow-xl"
                data-member={JSON.stringify({
                  name: member.name,
                  role: member.role,
                  angkatan: member.angkatan,
                  instagram: member.instagramUsn,
                  instagramUrl: member.instagramUrl,
                  bio: member.bio,
                  photo: member.resolvedPhoto?.src ?? "",
                })}
              >
                <div class="relative overflow-hidden aspect-square bg-primary/10">
                  {member.resolvedPhoto ? (
                    <Image
                      src={member.resolvedPhoto}
                      alt={member.name}
                      class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                      loading="eager"
                      fetchpriority="high"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center">
                      <span class="font-heading text-3xl font-bold text-primary/40">
                        {member.name.charAt(0)}
                      </span>
                    </div>
                  )}
                  <div class="absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-primary-darken/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
                </div>
                <div class="p-3">
                  <p class="font-heading font-bold text-sm text-primary-darken leading-snug line-clamp-2">
                    {member.name}
                  </p>
                  <p class="font-isi text-xs text-primary/60 mt-0.5 line-clamp-1">
                    {member.role}
                  </p>
                </div>
              </button>
            ))
          }
        </div>

        <nav
          aria-label="Departemen lain"
          class="mt-16 pt-10 border-t border-primary/10"
        >
          <h2 class="font-heading font-bold text-lg text-primary-darken mb-5">
            Lihat departemen lain
          </h2>
          <div class="flex flex-wrap gap-2">
            {
              others.map((d) => (
                <a
                  href={`/about/${d.id}`}
                  title={d.data.fullName}
                  class="font-isi text-sm md:text-base px-4 py-2 rounded-full border border-primary/20 bg-primary/5 text-primary transition-colors hover:bg-primary hover:text-secondary-bright hover:border-primary"
                >
                  {d.data.name}
                </a>
              ))
            }
          </div>
          <a
            href="/about#direktori"
            class="inline-block mt-6 font-isi text-sm font-semibold text-primary hover:text-primary-darken"
          >
            ← Kembali ke direktori anggota
          </a>
        </nav>
      </Container>

      {
        resolvedPrograms.length > 0 && (
          <Section mode="dark" direct={programId}>
            <Container class="py-20 md:py-24">
              <h2 class="font-heading font-bold text-center text-3xl md:text-5xl lg:text-6xl mb-12 heading-accent">
                Agenda
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                {resolvedPrograms.map((program) => (
                  <button
                    class="rounded-xl border border-secondary-bright/20 overflow-hidden text-left cursor-pointer group hover:scale-[1.02] transition-transform duration-300"
                    data-program={JSON.stringify({
                      name: program.name,
                      date: program.date,
                      programDesc: program.programDesc,
                      photo: program.resolvePicture?.src ?? "",
                    })}
                  >
                    <div class="h-56 w-full object-cover overflow-hidden bg-primary-darken/30 relative">
                      {program.resolvePicture ? (
                        <Image
                          src={program.resolvePicture}
                          alt={program.name}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center">
                          <span class="font-heading text-4xl font-bold text-secondary-bright/30">
                            {program.name.charAt(0)}
                          </span>
                        </div>
                      )}
                    </div>
                    <div class="p-4">
                      <p class="font-heading font-bold text-base text-secondary-bright">
                        {program.name}
                      </p>
                      {program.date && (
                        <p class="font-isi text-xs text-secondary-bright/50 mt-1">
                          {program.date}
                        </p>
                      )}
                    </div>
                  </button>
                ))}
              </div>
            </Container>
          </Section>
        )
      }
    </div>
  </Section>

  <!-- program modal -->
  <div
    id="program-modal"
    class="fixed inset-0 bg-neutralblack/60 backdrop-blur-sm z-50 items-center justify-center p-4 md:p-10"
    style="display: none"
  >
    <div
      class="relative bg-neutralwhite rounded-3xl w-full max-w-4xl max-h-[85vh] overflow-hidden flex flex-col md:flex-row shadow-2xl"
    >
      <button
        id="close-program-modal"
        class="absolute top-4 right-4 z-20 w-9 h-9 rounded-full bg-primary-darken/60 text-neutralwhite flex items-center justify-center hover:bg-primary-darken transition-colors text-sm font-bold cursor-pointer"
        aria-label="Tutup">✕</button
      >
      <!-- Foto program: di atas saat mobile, kiri saat desktop -->
      <div
        class="w-full h-52 shrink-0 md:h-auto md:w-5/12 overflow-hidden relative bg-primary-darken/10"
      >
        <img
          id="prog-modal-photo"
          src=""
          alt=""
          class="w-full h-full object-cover"
        />
        <div
          id="prog-modal-fallback"
          class="absolute inset-0 items-center justify-center bg-primary-darken/10"
          style="display: none"
        >
          <span
            id="prog-modal-initial"
            class="font-heading text-6xl font-bold text-primary-darken/30"
          ></span>
        </div>
      </div>
      <!-- Info program: di bawah saat mobile, kanan saat desktop -->
      <div class="w-full md:w-7/12 flex flex-col overflow-y-auto">
        <div class="p-6 md:p-10 flex flex-col h-full">
          <p
            id="prog-modal-name"
            class="font-heading font-bold text-xl md:text-3xl text-primary-darken leading-tight"
          >
          </p>
          <span
            id="prog-modal-date"
            class="inline-block mt-3 text-xs font-isi bg-primary/10 text-primary px-3 py-1 rounded-full w-fit"
          ></span>
          <hr class="my-4 md:my-6 border-primary/10" />
          <p
            id="prog-modal-desc"
            class="font-isi text-xs md:text-base leading-relaxed text-primary-darken flex-1"
          >
          </p>
          <!-- Placeholder kalau desc kosong -->
          <p
            id="prog-modal-empty"
            class="font-isi text-sm text-primary/30 italic flex-1"
            style="display: none"
          >
            Detail program belum tersedia.
          </p>
        </div>
      </div>
    </div>
  </div>
  <MemberModal />

  <script>
    // ─── Helper: typed getElementById ────────────────────────
    function el<T extends HTMLElement = HTMLElement>(id: string) {
      return document.getElementById(id) as T | null;
    }

    // ─── Helper: isi foto atau fallback huruf pertama ─────────
    function setPhoto(
      photoId: string,
      fallbackId: string,
      initialId: string,
      src: string,
      name: string,
    ) {
      const photo = el<HTMLImageElement>(photoId);
      const fallback = el(fallbackId);
      const initial = el(initialId);
      if (!photo || !fallback || !initial) return;

      if (src) {
        photo.src = src;
        photo.alt = name;
        photo.style.display = "block";
        fallback.style.display = "none";
      } else {
        photo.style.display = "none";
        fallback.style.display = "flex";
        initial.textContent = name.charAt(0);
      }
    }

    // ─── Helper: buka/tutup modal generik ────────────────────
    function openModal(id: string) {
      const modal = el(id);
      if (!modal) return;
      modal.style.display = "flex";
      document.body.style.overflow = "hidden";
    }

    function closeModal(id: string) {
      const modal = el(id);
      if (!modal) return;
      modal.style.display = "none";
      document.body.style.overflow = "";
    }

    // ─── Populate program modal ───────────────────────────────
    // Modal member ditangani sendiri oleh komponen MemberModal.astro
    function showProgram(data: {
      name: string;
      date?: string;
      programDesc?: string;
      photo?: string;
    }) {
      el("prog-modal-name")!.textContent = data.name;

      const dateEl = el("prog-modal-date");
      if (dateEl) {
        dateEl.textContent = data.date ?? "";
        dateEl.style.display = data.date ? "inline-block" : "none";
      }

      const descEl = el("prog-modal-desc");
      const emptyEl = el("prog-modal-empty");
      if (descEl && emptyEl) {
        const hasDesc = Boolean(data.programDesc);
        descEl.textContent = data.programDesc ?? "";
        descEl.style.display = hasDesc ? "block" : "none";
        emptyEl.style.display = hasDesc ? "none" : "block";
      }

      setPhoto(
        "prog-modal-photo",
        "prog-modal-fallback",
        "prog-modal-initial",
        data.photo ?? "",
        data.name,
      );

      openModal("program-modal");
    }

    // ─── Event delegation ─────────────────────────────────────
    // Satu listener di document — tidak butuh re-attach setelah View Transitions
    document.addEventListener("click", (e) => {
      const t = e.target as Element;

      // Klik kartu program
      const programCard = t.closest<HTMLElement>("[data-program]");
      if (programCard?.dataset.program) {
        showProgram(JSON.parse(programCard.dataset.program));
        return;
      }

      // Tutup program modal: tombol X atau klik backdrop
      if (t.closest("#close-program-modal") || t.id === "program-modal") {
        closeModal("program-modal");
        return;
      }
    });

    // Escape menutup modal program
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      closeModal("program-modal");
    });
  </script>
</Layout>
