---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
const {
  Pagetitle = "HIMAFI",
  description = "HIMAFI UIN Syarif Hidayatullah Jakarta...",
  image = "/himafi.png",
  noindex = false,
} = Astro.props;

// og:image wajib URL absolut — kalau relatif, WhatsApp/Instagram/Twitter
// tidak bisa mengambil gambarnya saat link di-share.
const base = Astro.site ?? new URL(Astro.url.origin);
const ogImage = new URL(image, base).href;
const canonical = new URL(Astro.url.pathname, base).href;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${Pagetitle} | HIMAFI`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HIMAFI UIN Jakarta" />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${Pagetitle} | HIMAFI`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href="/himafi.png" />
    <meta name="generator" content={Astro.generator} />
    <!-- font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Playfair:ital,opsz,wght@0,5..1200,300..900;1,5..1200,300..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
      rel="stylesheet"
    />
    <!-- font end -->
    <title>{Pagetitle} | HIMAFI</title>
  </head>
  <body>
    <div class="[overflow-x:clip] w-full">
      <a
        href="#main"
        class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-full focus:bg-primary-darken focus:px-5 focus:py-3 focus:font-isi focus:font-semibold focus:text-secondary-bright"
      >
        Lompat ke konten
      </a>
      <Navbar />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <ClientRouter />
  </body>
</html>
