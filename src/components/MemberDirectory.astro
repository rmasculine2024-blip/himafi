---
// Direktori anggota lintas departemen dengan filter chip.
// Data diambil dari collection `departments` — nambah/ubah anggota cukup
// edit JSON-nya, komponen ini tidak perlu disentuh.
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { memberImages, findImage } from "../utils/image";
import { sortDepartments } from "../utils/departments";

const departments = sortDepartments(await getCollection("departments"));

const members = departments.flatMap((dept) =>
  dept.data.members.map((member) => ({
    ...member,
    deptId: dept.id,
    deptName: dept.data.name,
    resolvedPhoto: findImage(memberImages, member.profilePic),
  })),
);
---

<div id="direktori" class="px-4 sm:px-6 md:px-16 lg:px-42 pb-16">
  <div class="flex flex-col items-center gap-2">
    <h2
      class="font-heading font-bold text-2xl md:text-3xl text-primary heading-accent"
    >
      Direktori Anggota
    </h2>
    <p class="font-isi text-fluid-body text-primary/70 text-center">
      Pilih departemen untuk menyaring daftar pengurus.
    </p>
  </div>

  <!-- Filter chip: horizontal-scroll di HP, wrap di desktop -->
  <div
    class="mt-6 -mx-4 px-4 sm:mx-0 sm:px-0 overflow-x-auto md:overflow-visible"
  >
    <div
      role="group"
      aria-label="Filter departemen"
      class="flex md:flex-wrap md:justify-center gap-2 w-max md:w-auto"
    >
      <button
        type="button"
        data-filter="all"
        aria-pressed="true"
        class="member-chip shrink-0 font-isi text-sm md:text-base px-4 py-2 rounded-full border border-primary/20 cursor-pointer transition-all duration-200 bg-primary text-secondary-bright shadow-md aria-[pressed=false]:bg-primary/5 aria-[pressed=false]:text-primary aria-[pressed=false]:shadow-none hover:aria-[pressed=false]:bg-primary/15"
      >
        Semua
      </button>
      {
        departments.map((dept) => (
          <button
            type="button"
            data-filter={dept.id}
            aria-pressed="false"
            title={dept.data.fullName}
            class="member-chip shrink-0 font-isi text-sm md:text-base px-4 py-2 rounded-full border border-primary/20 cursor-pointer transition-all duration-200 bg-primary text-secondary-bright shadow-md aria-[pressed=false]:bg-primary/5 aria-[pressed=false]:text-primary aria-[pressed=false]:shadow-none hover:aria-[pressed=false]:bg-primary/15"
          >
            {dept.data.name}
          </button>
        ))
      }
    </div>
  </div>

  <p
    id="member-count"
    aria-live="polite"
    class="mt-4 font-isi text-sm text-primary/60 text-center"
  >
    Menampilkan {members.length} pengurus
  </p>

  <div
    id="member-grid"
    class="mt-6 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 md:gap-6"
  >
    {
      members.map((member) => (
        <button
          type="button"
          class="member-card lift text-left group cursor-pointer rounded-2xl overflow-hidden bg-neutralwhite ring-1 ring-primary/10 shadow-sm hover:shadow-xl"
          data-dept={member.deptId}
          data-member={JSON.stringify({
            name: member.name,
            role: member.role,
            angkatan: member.angkatan,
            instagram: member.instagramUsn,
            instagramUrl: member.instagramUrl,
            bio: member.bio,
            photo: member.resolvedPhoto?.src ?? "",
          })}
        >
          <div class="relative overflow-hidden aspect-square bg-primary/10">
            {member.resolvedPhoto ? (
              <Image
                src={member.resolvedPhoto}
                alt={member.name}
                loading="lazy"
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center">
                <span class="font-heading text-3xl font-bold text-primary/40">
                  {member.name.charAt(0)}
                </span>
              </div>
            )}
            <div class="absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-primary-darken/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
            <span class="absolute top-2 left-2 font-isi text-[0.6rem] font-bold uppercase tracking-wider bg-neutralwhite/90 text-primary px-2 py-0.5 rounded-full shadow-sm">
              {member.deptName}
            </span>
          </div>
          <div class="p-3">
            <p class="font-heading font-bold text-sm text-primary-darken leading-snug line-clamp-2">
              {member.name}
            </p>
            <p class="font-isi text-xs text-primary/60 mt-0.5 line-clamp-1">
              {member.role}
            </p>
          </div>
        </button>
      ))
    }
  </div>
</div>

<script>
  function initMemberDirectory() {
    const grid = document.getElementById("member-grid");
    if (!grid) return;

    const chips =
      document.querySelectorAll<HTMLButtonElement>("button.member-chip");
    const cards = grid.querySelectorAll<HTMLElement>(".member-card");
    const counter = document.getElementById("member-count");

    // Hanya id departemen yang benar-benar ada yang diterima, supaya
    // ?dept=ngasal dari URL tidak menghasilkan grid kosong
    const known = new Set(
      Array.from(chips, (chip) => chip.dataset.filter ?? "all"),
    );

    function apply(filter: string, syncUrl = true) {
      if (!known.has(filter)) filter = "all";

      let shown = 0;
      cards.forEach((card) => {
        const match = filter === "all" || card.dataset.dept === filter;
        card.classList.toggle("hidden", !match);
        if (match) shown++;
      });
      chips.forEach((chip) =>
        chip.setAttribute(
          "aria-pressed",
          String(chip.dataset.filter === filter),
        ),
      );
      if (counter) counter.textContent = `Menampilkan ${shown} pengurus`;

      if (!syncUrl) return;

      // Simpan pilihan di URL supaya bisa di-share dan tahan refresh.
      // replaceState, bukan pushState: menambah entri riwayat tiap klik chip
      // bikin tombol back harus ditekan berkali-kali cuma untuk keluar
      // halaman, dan pushState di luar ClientRouter bisa mengacaukan
      // pemulihan posisi scroll milik Astro.
      const url = new URL(location.href);
      if (filter === "all") {
        url.searchParams.delete("dept");
        url.hash = "";
      } else {
        url.searchParams.set("dept", filter);
        url.hash = "direktori";
      }
      history.replaceState(history.state, "", url);
    }

    chips.forEach((chip) =>
      chip.addEventListener("click", () => apply(chip.dataset.filter ?? "all")),
    );

    // Terapkan filter dari URL saat halaman dibuka; jangan tulis ulang URL-nya
    apply(new URL(location.href).searchParams.get("dept") ?? "all", false);
  }

  // astro:page-load juga jalan di initial load, jadi cukup satu pendaftaran ini.
  // (Layout memakai <ClientRouter />, script modul tidak dieksekusi ulang saat navigasi.)
  document.addEventListener("astro:page-load", initMemberDirectory);
</script>
