---
import himafiLogo from "../assets/logo/himafi.png";
import { Image } from "astro:assets";

// Astro membangun URL dengan trailing slash ("/about/"), jadi perbandingan
// mentah terhadap "/about" tidak pernah cocok. Normalkan dulu.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const menu = [
  { href: "/", label: "Beranda" },
  { href: "/about", label: "Tentang" },
  { href: "/news", label: "Berita" },
  { href: "/contact", label: "Kontak" },
  { href: "/utility", label: "Utilitas", hidden: true },
];

// Halaman turunan ikut menyalakan induknya: /about/litbang -> Tentang,
// /news/raker -> Berita.
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<nav
  class="navbar flex justify-center z-50 fixed top-0 left-0 w-full transition-transform duration-300 ease-in-out"
>
  <!-- Container Pill Utama -->
  <div class="nav-container relative z-20 w-full max-w-7xl">
    <a href="/"
      ><Image
        src={himafiLogo}
        class="navbar-icon"
        alt="Logo"
        loading="eager"
        fetchpriority="high"
      /></a
    >

    <!-- Menu Desktop -->
    <div class="hidden md:flex">
      <ul class="flex gap-8">
        {
          menu.map(({ href, label, hidden }) => (
            <li class={hidden ? "hidden" : undefined}>
              <a
                href={href}
                class={`a-menu ${isActive(href) ? "bg-primary text-neutralwhite" : ""}`}
                aria-current={isActive(href) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Tombol Hamburger Mobile -->
    <div class="inset-y-0 left-0 flex items-center md:hidden">
      <button
        type="button"
        id="hamburger"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="relative inline-flex items-center justify-center rounded-md p-2 text-primary hover:bg-primary/10 hover:text-primary-darken"
      >
        <span class="sr-only">Buka menu utama</span>
        <!-- Ikon Garis Tiga (Menu) -->
        <svg
          id="icon-menu"
          class="block h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>
        <!-- Ikon Silang (X) -->
        <svg
          id="icon-close"
          class="hidden h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- BLOK MOBILE MENU (Dropdown)                -->
  <!-- ========================================== -->
  <div
    id="mobile-menu"
    class="hidden absolute top-full left-0 w-full px-4 mt-2 z-10 md:hidden"
  >
    <div
      class="bg-neutralwhite rounded-2xl shadow-xl ring-1 ring-primary/10 px-4 pt-2 pb-4 space-y-2"
    >
      {
        menu.map(({ href, label, hidden }) => (
          <a
            href={href}
            class={`${hidden ? "hidden" : "block"} px-3 py-2 rounded-md text-base font-medium ${
              isActive(href)
                ? "bg-primary text-neutralwhite"
                : "text-primary hover:bg-primary/10 hover:text-primary-darken"
            }`}
            aria-current={isActive(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </div>
  </div>
  <!-- Akhir Blok Mobile Menu -->
</nav>

<script>
  // Elemen dicari ulang tiap dipakai karena View Transitions mengganti DOM,
  // sementara script modul ini cuma dieksekusi sekali.
  const el = (id: string) => document.getElementById(id);

  function closeMobileMenu() {
    el("mobile-menu")?.classList.add("hidden");
    el("icon-menu")?.classList.remove("hidden");
    el("icon-close")?.classList.add("hidden");
    el("hamburger")?.setAttribute("aria-expanded", "false");
  }

  // === Hide on Scroll Down, Show on Scroll Up ===
  // Didaftarkan SEKALI di level modul. Versi sebelumnya memanggil
  // removeEventListener dengan referensi fungsi yang baru dibuat, jadi tidak
  // menghapus apa pun dan listener menumpuk tiap navigasi client-side.
  let lastScrollY = window.scrollY;

  window.addEventListener(
    "scroll",
    () => {
      const navbar = document.querySelector("nav");
      if (!navbar) return;

      const y = window.scrollY;
      if (y > lastScrollY && y > 80) {
        navbar.style.transform = "translateY(-150%)";
        closeMobileMenu();
      } else {
        navbar.style.transform = "translateY(0)";
      }
      lastScrollY = y;
    },
    { passive: true },
  );

  // === Hamburger ===
  // astro:page-load jalan di initial load dan tiap selesai navigasi. Tombolnya
  // elemen baru tiap kali, jadi listener-nya tidak pernah dobel.
  document.addEventListener("astro:page-load", () => {
    const btn = el("hamburger");
    if (!btn) return;

    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      if (isOpen) {
        closeMobileMenu();
      } else {
        el("mobile-menu")?.classList.remove("hidden");
        el("icon-menu")?.classList.add("hidden");
        el("icon-close")?.classList.remove("hidden");
        btn.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
