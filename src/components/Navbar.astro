---
import himafiLogo from "../assets/logo/himafi.png";
import { Image } from "astro:assets";
const currentPath = Astro.url.pathname;
---

<nav
  class="navbar flex justify-center z-50 fixed top-0 left-0 w-full transition-transform duration-300 ease-in-out"
>
  <!-- Container Pill Utama -->
  <div class="nav-container relative z-20 w-full max-w-7xl">
    <a href="/"
      ><Image
        src={himafiLogo}
        class="navbar-icon"
        alt="Logo"
        loading="eager"
        fetchpriority="high"
      /></a
    >

    <!-- Menu Desktop -->
    <div class="hidden md:flex">
      <ul class="flex gap-8">
        <li>
          <a
            href="/"
            class={`a-menu ${currentPath === "/" ? "bg-primary text-neutralwhite" : ""}`}
            aria-current={currentPath === "/" ? "page" : undefined}>Beranda</a
          >
        </li>
        <li>
          <a
            href="/about"
            class={`a-menu ${currentPath === "/about" ? "bg-primary text-neutralwhite" : ""}`}
            aria-current={currentPath === "/about" ? "page" : undefined}
            >Tentang</a
          >
        </li>
        <li>
          <a
            href="/news"
            class={`a-menu ${currentPath === "/news" ? "bg-primary text-neutralwhite" : ""}`}
            aria-current={currentPath === "/news" ? "page" : undefined}
            >Berita</a
          >
        </li>
        <li>
          <a
            href="/contact"
            class={`a-menu ${currentPath === "/contact" ? "bg-primary text-neutralwhite" : ""}`}
            aria-current={currentPath === "/contact" ? "page" : undefined}
            >Kontak</a
          >
        </li>
        <li class="hidden">
          <a
            href="/utility"
            class={`a-menu ${currentPath === "/utility" ? "bg-primary text-neutralwhite" : ""}`}
            aria-current={currentPath === "/utility" ? "page" : undefined}
            >Utilitas</a
          >
        </li>
      </ul>
    </div>

    <!-- Tombol Hamburger Mobile -->
    <div class="inset-y-0 left-0 flex items-center md:hidden">
      <button
        type="button"
        id="hamburger"
        aria-expanded="false"
        class="relative inline-flex items-center justify-center rounded-md p-2 text-primary hover:bg-primary/10 hover:text-primary-darken focus:outline-none focus:ring-2 focus:ring-inset focus:ring-primary-darken"
      >
        <span class="sr-only">Open main menu</span>
        <!-- Ikon Garis Tiga (Menu) -->
        <svg
          id="icon-menu"
          class="block h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>
        <!-- Ikon Silang (X) -->
        <svg
          id="icon-close"
          class="hidden h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- BLOK MOBILE MENU (Dropdown)                -->
  <!-- ========================================== -->
  <div
    id="mobile-menu"
    class="hidden absolute top-full left-0 w-full px-4 mt-2 z-10 md:hidden"
  >
    <div
      class="bg-neutralwhite rounded-2xl shadow-xl ring-1 ring-primary/10 px-4 pt-2 pb-4 space-y-2"
    >
      <a
        href="/"
        class="block px-3 py-2 rounded-md text-base font-medium text-primary hover:bg-primary/10 hover:text-primary-darken"
        >Beranda</a
      >
      <a
        href="/about"
        class="block px-3 py-2 rounded-md text-base font-medium text-primary hover:bg-primary/10 hover:text-primary-darken"
        >Tentang</a
      >
      <a
        href="/news"
        class="block px-3 py-2 rounded-md text-base font-medium text-primary hover:bg-primary/10 hover:text-primary-darken"
        >Berita</a
      >
      <a
        href="/contact"
        class="block px-3 py-2 rounded-md text-base font-medium text-primary hover:bg-primary/10 hover:text-primary-darken"
        >Kontak</a
      >
      <a
        href="/utility"
        class="hidden px-3 py-2 rounded-md text-base font-medium text-primary hover:bg-primary/10 hover:text-primary-darken "
        >Utilitas</a
      >
    </div>
  </div>
  <!-- Akhir Blok Mobile Menu -->
</nav>

<script>
  function init() {
    // === Hamburger Menu ===
    const btnHamburger = document.getElementById(
      "hamburger",
    ) as HTMLButtonElement;
    const mobileMenu = document.getElementById("mobile-menu") as HTMLElement;
    const iconMenu = document.getElementById("icon-menu") as HTMLElement;
    const iconClose = document.getElementById("icon-close") as HTMLElement;
    const navbar = document.querySelector("nav") as HTMLElement;

    if (!btnHamburger || !mobileMenu || !iconMenu || !iconClose || !navbar)
      return;

    // Clone button untuk cegah double event listener
    const newBtn = btnHamburger.cloneNode(true) as HTMLButtonElement;
    btnHamburger.parentNode!.replaceChild(newBtn, btnHamburger);

    newBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");
      iconMenu.classList.toggle("hidden");
      iconClose.classList.toggle("hidden");
      iconClose.classList.toggle("block");

      const isExpanded = newBtn.getAttribute("aria-expanded") === "true";
      newBtn.setAttribute("aria-expanded", String(!isExpanded));
    });

    // === Hide on Scroll Down, Show on Scroll Up ===
    let lastScrollY = window.scrollY;

    // Clone window scroll juga biar tidak numpuk tiap navigasi
    const handleScroll = () => {
      const currentScrollY = window.scrollY;

      if (currentScrollY > lastScrollY && currentScrollY > 80) {
        navbar.style.transform = "translateY(-150%)";
        mobileMenu.classList.add("hidden");
        iconMenu.classList.remove("hidden");
        iconClose.classList.add("hidden");
      } else {
        navbar.style.transform = "translateY(0)";
      }

      lastScrollY = currentScrollY;
    };

    // Hapus scroll listener lama sebelum pasang baru
    window.removeEventListener("scroll", handleScroll);
    window.addEventListener("scroll", handleScroll);
  }

  // First load
  init();

  // Setelah navigasi antar halaman (View Transitions)
  document.addEventListener("astro:after-swap", init);
</script>
